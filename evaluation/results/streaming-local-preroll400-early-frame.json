    {
      "epoch": 1,
      "type": "asr.final",
      "segment_id": "local_7",
      "source_revision": 3,
      "source_text": "日本人は決してユーモアと無縁な人種ではなかった。",
      "start_audio_ms": 44368,
      "end_audio_ms": 49056,
      "asr_final": true,
